{
  "name": "flight-tracker-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bot that tracks flights via free ADS-B APIs and posts periodic map/status updates in threads.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "register-commands": "node dist/discord/registerCommands.js"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "pg": "^8.13.1",
    "undici": "^7.2.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20"
  }
}
