DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
POSTGRES_DB=discord_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_secure_password
DATABASE_URL=postgres://postgres:change_this_to_secure_password@postgres:5432/discord_bot
NODE_ENV=production
LOG_LEVEL=info

# --- Optional settings below (sensible defaults are used if omitted) ---

# Register slash commands to a single guild for instant availability during
# development. Leave unset to register globally (can take up to ~1 hour to
# propagate to all servers).
# DISCORD_GUILD_ID=your_test_guild_id_here

# Scheduler / tracking limits
DEFAULT_UPDATE_INTERVAL_SECONDS=300
MIN_UPDATE_INTERVAL_SECONDS=60
MAX_UPDATE_INTERVAL_SECONDS=3600
MAX_TRACKINGS_PER_GUILD=15

# ADS-B data sources (free, no API key). Primary is tried first; on failure
# or empty result the fallback is queried.
ADSB_PRIMARY_URL=https://api.adsb.lol
ADSB_FALLBACK_URL=https://opendata.adsb.fi/api
ADSB_META_URL=https://api.adsbdb.com/v0
ADSB_RATE_LIMIT_PER_SEC=1

# Map tile source used to render the position snapshot embedded in updates.
# Must be a standard {z}/{x}/{y} XYZ tile template. Swap this if the default
# public tile host rate-limits or blocks the bot.
MAP_TILE_URL_TEMPLATE=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
MAP_ATTRIBUTION=(c) OpenStreetMap contributors (c) CARTO

# Directory (inside the container) where downloaded map tiles are cached to
# disk. Mounted as a volume in docker-compose.yml so the cache survives
# restarts.
TILE_CACHE_DIR=/app/.tilecache
